@page "/"

<PageTitle>ServiceFlow - Field Service Management</PageTitle>

<h1>ServiceFlow</h1>

<p class="lead">Field Service Management &mdash; customers, jobs, technicians, and scheduling in one place.</p>

<div class="card-grid">
    <div class="feature-card">
        <h2>Customers</h2>
        <p>Track customer accounts, contacts, and service addresses.</p>
        <a class="btn btn-primary" href="customers">Manage customers</a>
    </div>
    <div class="feature-card">
        <h2>Jobs</h2>
        <p>Create jobs, assign technicians, and follow status through completion.</p>
        <a class="btn btn-primary" href="jobs">View jobs</a>
    </div>
    <div class="feature-card">
        <h2>Dashboard</h2>
        <p>Monitor open, scheduled, completed, and overdue work at a glance.</p>
        <a class="btn btn-primary" href="dashboard">Open dashboard</a>
    </div>
</div>

